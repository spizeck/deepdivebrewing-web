rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasAdminClaim() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if hasAdminClaim();
    }
  }
}
