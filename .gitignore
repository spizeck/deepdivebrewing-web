# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# service account / credentials
**/*firebase-adminsdk*.json
**/*serviceAccount*.json
**/*service-account*.json

# verification screenshots generated locally
/screenshots

# playwright smoke-test artifacts
/test-results/
/playwright-report/

# firebase emulator artifacts
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
firebase-export-*/

